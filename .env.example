# ==============================================================================
# Bharat Banking - Enterprise Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your real credentials.
# NEVER commit the actual '.env' file containing secrets to version control.

# Google Gemini API Settings
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Backend & Networking Settings
API_HOST=127.0.0.1
API_PORT=8000
API_URL=http://127.0.0.1:8000

# File Paths (Defaults to project root if left blank)
DATABASE_PATH=bharat_banking.db
MODEL_PATH=efficiency_model.pkl
